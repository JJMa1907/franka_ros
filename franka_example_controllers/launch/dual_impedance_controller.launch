<?xml version="1.0"?>
<launch>
  <!-- Robot arm ID -->
  <arg name="robot_ip" default="172.16.0.2" />
  <arg name="arm_id" default="panda" />
  <arg name="load_gripper" default="true" />
  <arg name="launch_rviz" default="true" />
  
  <!-- Controller selection arguments -->
  <arg name="controller" default="dual_impedance_controller" />
  <arg name="start_mode" default="cartesian" doc="Initial mode: 'cartesian' or 'joint'" />
  
  <!-- Start dual impedance controller -->
  <group>
    <!-- Load controller configuration -->
    <rosparam file="$(find franka_example_controllers)/config/dual_impedance_controller.yaml" command="load" />
    
    <!-- Set initial mode -->
    <param name="default_mode" value="true" if="$(eval arg('start_mode') == 'cartesian')" />
    <param name="default_mode" value="false" if="$(eval arg('start_mode') == 'joint')" />
    
    <!-- Start the franka control node -->
    <include file="$(find franka_control)/launch/franka_control.launch">
      <arg name="robot_ip" value="$(arg robot_ip)" />
      <arg name="load_gripper" value="$(arg load_gripper)" />
      <arg name="arm_id" value="$(arg arm_id)" />
    </include>

    <!-- Spawn the dual impedance controller with delay to ensure proper initialization -->
    <node name="controller_spawner" pkg="controller_manager" type="spawner" respawn="false" output="screen" 
          args="$(arg controller)"
          launch-prefix="bash -c 'sleep 1.0; $0 $@'" />

    <!-- Load dynamic reconfigure compliance parameters for cartesian mode -->
    <!-- Give the dynparam node time to start up before loading parameters -->
    <node name="dynamic_reconfigure_compliance_param_node" pkg="dynamic_reconfigure" type="dynparam" output="screen" 
          args="load dynamic_reconfigure_compliance_param_node $(find franka_example_controllers)/config/franka_example_controller.yaml"
          launch-prefix="bash -c 'sleep 2.0; $0 $@'" />

    <!-- Start rviz with appropriate config if requested -->
    <node name="rviz" pkg="rviz" type="rviz" output="screen" 
          args="-d $(find franka_example_controllers)/launch/rviz/franka_description_with_marker.rviz" 
          if="$(eval arg('load_gripper') and arg('launch_rviz'))" />
  </group>
</launch>
