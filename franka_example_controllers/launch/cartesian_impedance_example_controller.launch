<?xml version="1.0" ?>
<launch>
  <arg name="robot_ip" default="172.16.0.2"/>
  <arg name="load_gripper" default="true" />
  <arg name="arm_id" default="panda" />
  <arg name="backend" default="ros_control" />
  <arg name="robot" default="panda" />
  <arg name="launch_rviz" default="true" />
  <arg name="launch_marker" default="true" />
  <arg name="launch_rqt" default="false" />
  <arg name="dynamics" default="0.05" />
  <arg name="auto_recover" default="true" />
  <arg name="connect_on_start" default="false" />
  <arg name="pose_rate_hz" default="20.0" />
  <arg name="external_command_hold_sec" default="10.0" />
  <arg name="xacro_args" default="" />

  <include file="$(find franka_control)/launch/franka_control.launch" if="$(eval arg('backend') == 'ros_control')">
    <arg name="robot_ip" value="$(arg robot_ip)" />
    <arg name="load_gripper" value="$(arg load_gripper)" />
    <arg name="arm_id" value="$(arg arm_id)" />
  </include>

  <param if="$(eval arg('backend') == 'franky')" name="robot_description"
         command="$(find xacro)/xacro $(find franka_description)/robots/$(arg robot)/$(arg robot).urdf.xacro hand:=$(arg load_gripper) arm_id:=$(arg arm_id) $(arg xacro_args)"/>

  <rosparam if="$(eval arg('backend') == 'ros_control')" command="load"
            file="$(find franka_example_controllers)/config/franka_example_controllers.yaml" subst_value="true" />
  <node if="$(eval arg('backend') == 'ros_control')" name="controller_spawner" pkg="controller_manager"
        type="spawner" respawn="false" output="screen" args="cartesian_impedance_example_controller"/>

  <node if="$(eval arg('backend') == 'franky')" name="franky_cartesian_impedance_compat"
        pkg="franka_example_controllers" type="franky_cartesian_impedance_compat.py"
        respawn="false" output="screen" required="true"
        args="--robot-ip $(arg robot_ip) --load-gripper $(arg load_gripper) --dynamics $(arg dynamics) --auto-recover $(arg auto_recover) --interface ros --pose-rate-hz $(arg pose_rate_hz) --arm-id $(arg arm_id) --connect-on-start $(arg connect_on_start) --external-command-hold-sec $(arg external_command_hold_sec)"/>
  <node if="$(eval arg('backend') == 'franky')" name="robot_state_publisher" pkg="robot_state_publisher"
        type="robot_state_publisher" output="screen"/>
  <node if="$(eval arg('backend') == 'franky' and arg('launch_marker'))" name="interactive_marker"
        pkg="franka_example_controllers" type="interactive_marker.py" required="false" output="screen">
    <param name="link_name" value="$(arg arm_id)_link0" />
  </node>

  <node if="$(eval arg('launch_rviz'))" pkg="rviz" type="rviz" output="screen" name="rviz"
        args="-d $(find franka_example_controllers)/launch/rviz/franka_description_with_marker.rviz"/>
  <node if="$(eval arg('backend') == 'ros_control' or (arg('backend') == 'franky' and arg('launch_rqt')))" name="rqt_reconfigure"
        pkg="rqt_reconfigure" type="rqt_reconfigure" required="false" />
</launch>
