<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="realsense_d435i_camera" params="prefix:='camera1' parent:='panda_link8'">
    <!-- Camera link -->
    <link name="${prefix}_base_link">
      <visual>
        <geometry>
          <box size="0.025 0.09 0.025"/>
        </geometry>
        <material name="blue">
          <color rgba="0 0 0.8 0.8"/>
        </material>
      </visual>
      <collision>
        <geometry>
          <box size="0.025 0.09 0.025"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.1"/>
        <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
      </inertial>
    </link>

    <!-- Joint between parent link and camera -->
    <joint name="${prefix}_base_joint" type="fixed">
      <origin xyz="0.03 -0.03 0.05" rpy="0 ${-pi/2} ${3*pi/4}" />
      <parent link="${parent}"/>
      <child link="${prefix}_base_link"/>
    </joint>

    <!-- Define a frame at the optical center with proper orientation -->
    <link name="${prefix}_optical_frame"/>
    <joint name="${prefix}_optical_joint" type="fixed">
      <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}" />
      <parent link="${prefix}_base_link"/>
      <child link="${prefix}_optical_frame"/>
    </joint>
  </xacro:macro>
</robot>
